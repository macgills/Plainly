{
  "manifest_version": 3,
  "name": "Plainly",
  "version": "0.5.0",
  "description": "Browse web articles at an adjusted reading target.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Plainly",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["content.css"],
      "js": ["generated/plainly-core.js", "article-extractor.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
